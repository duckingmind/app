# Configuration reference; the CLI does not automatically load .env files.
# Export these values in your shell before starting the CLI.
# Platform API used by the CLI for app management.
PROXY_API_BASE_URL=http://localhost:9003/api

# Set this only in the shell or CI secret store. Never commit a real token.
# PROXY_USER_ACCESS_TOKEN=

# Portal used by local development login handoff.
PROXY_PORTAL_URL=http://localhost:9004
