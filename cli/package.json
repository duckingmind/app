{
  "name": "@ducking-mind/proxy-app-cli",
  "version": "0.2.0",
  "description": "CLI for creating, building and publishing Proxy platform apps",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duckingmind/app.git",
    "directory": "cli"
  },
  "homepage": "https://github.com/duckingmind/app/tree/main/cli#readme",
  "bugs": {
    "url": "https://github.com/duckingmind/app/issues"
  },
  "type": "module",
  "exports": {
    ".": "./proxy-app.mjs",
    "./agent-contract": "./agent-contract.mjs",
    "./agent-protocol": "./agent-runtime/protocol.mjs",
    "./package-guide": "./agent-runtime/package-guide.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "proxy-app": "proxy-app.mjs",
    "proxy-agent-contract": "agent-contract.mjs"
  },
  "files": [
    "proxy-app.mjs",
    "backend-container.mjs",
    "platform-settings.mjs",
    "local-dev-relay.mjs",
    "local-dev-credentials.mjs",
    "runtime-sources.mjs",
    "artifact-security.mjs",
    "agent-contract.mjs",
    "agent-runtime/protocol.mjs",
    "agent-runtime/package-guide.mjs",
    "prepare-agent-runtime.mjs"
  ],
  "scripts": {
    "test": "node --check proxy-app.mjs && node --check agent-contract.mjs && node --check runtime-sources.mjs && node --test *.test.mjs",
    "prepublishOnly": "npm test",
    "prepack": "node prepare-agent-runtime.mjs",
    "pretest": "npm --prefix ../proxy-app-sdk run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "engines": {
    "node": ">=22.18"
  },
  "license": "MIT"
}
