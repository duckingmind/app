{
  "name": "proxy-chat-app",
  "version": "0.0.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "proxy-app dev .",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && proxy-agent-contract . dist",
    "dev:server": "vite",
    "validate": "proxy-app validate .",
    "pack": "proxy-app pack --output dist/chat.zip",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "dependencies": {
    "@ducking-mind/proxy-app-sdk": "^0.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@ducking-mind/proxy-app-cli": "^0.2.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.2.2",
    "vite": "^8.2.2"
  }
}
