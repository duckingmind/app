{
  "schema": "proxy.app/v1",
  "id": "pelican",
  "version": "0.3.8",
  "name": "Pelican Probe",
  "description": "通过 llm-gateway 生成并展示鹈鹕骑自行车的 HTML/SVG 动画，用于观察模型输出质量。",
  "assets": {
    "icon": "favicon.svg"
  },
  "functions": {
    "task": {
      "entry": "runtime/task.mjs",
      "concurrency": 2,
      "max_attempts": 2,
      "timeout_ms": 2100000
    }
  }
}
