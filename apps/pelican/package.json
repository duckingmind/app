{
  "name": "proxy-pelican-app",
  "version": "0.3.7",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "proxy-app dev .",
    "dev:server": "vite",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "validate": "proxy-app validate .",
    "pack": "proxy-app pack . --output dist/pelican.zip",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "dependencies": {
    "@ducking-mind/proxy-app-sdk": "^0.2.0",
    "lucide-react": "^0.468.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@ducking-mind/proxy-app-cli": "^0.2.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "engines": {
    "node": ">=22.18"
  }
}
