{
  "name": "proxy-design-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../cli/proxy-app.mjs dev .",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node ../../cli/agent-contract.mjs . dist",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:ui": "node tests/ui-smoke.mjs",
    "test:auth": "node tests/ui-smoke.mjs --auth",
    "dev:server": "vite",
    "validate": "node ../../cli/proxy-app.mjs validate .",
    "pack": "node ../../cli/proxy-app.mjs pack --output dist/design.zip"
  },
  "dependencies": {
    "@ducking-mind/proxy-app-sdk": "^0.1.0",
    "fflate": "^0.8.2",
    "lucide-react": "^0.468.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.2.2",
    "vite": "^8.2.2"
  }
}
