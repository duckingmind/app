desktop/**/release/
*.zip
*.tgz
.proxy-app.json
.DS_Store

# Desktop release publisher credentials. Keep release.config.example.json in
# the repository; never commit the working config containing the API key.
desktop/release-config.json
desktop/release-config.local.json
desktop/release.config.json
desktop/release.config.local.json
# Any named release profile may contain the API key; the example stays tracked.
desktop/release.config.*.json
!desktop/release.config.example.json
# Generated public updater config is written during packaging and restored locally.
desktop/update-config.json
desktop/.electron-builder-release-*.json

